{
  "name": "@dudousxd/nestjs-agent-store-drizzle",
  "version": "0.3.3",
  "description": "nestjs-agent Drizzle ORM agent store (threads, messages, tool calls, usage)",
  "license": "MIT",
  "author": "Davide Carvalho",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dudousxd/nestjs-agent-core": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "drizzle-orm": ">=0.40.0 <1.0.0"
  },
  "devDependencies": {
    "@dudousxd/nestjs-agent-core": "workspace:*",
    "@nestjs/common": "11.1.6",
    "@types/better-sqlite3": "7.6.13",
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "0.45.2",
    "tsup": "8.3.5",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
