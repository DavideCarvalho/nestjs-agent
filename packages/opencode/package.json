{
  "name": "@dudousxd/nestjs-agent-opencode",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-agent.git",
    "directory": "packages/opencode"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/agent",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-agent/issues"
  },
  "keywords": [
    "nestjs",
    "agent",
    "opencode"
  ],
  "description": "nestjs-agent engine that runs turns on an OpenCode 2 server — the library's routes, threads, stream, approvals and queue over OpenCode's loop",
  "license": "MIT",
  "author": "Davide Carvalho",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./durable": {
      "import": {
        "types": "./dist/durable/index.d.ts",
        "default": "./dist/durable/index.js"
      },
      "require": {
        "types": "./dist/durable/index.d.cts",
        "default": "./dist/durable/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:specs": "tsc -p tsconfig.spec.json"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-agent": ">=1.21.0 <2.0.0",
    "@dudousxd/nestjs-agent-core": ">=0.40.0 <1.0.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@dudousxd/nestjs-durable": ">=0.45.0",
    "@dudousxd/nestjs-durable-core": ">=0.72.0"
  },
  "devDependencies": {
    "@dudousxd/nestjs-agent": "workspace:*",
    "@dudousxd/nestjs-agent-core": "workspace:*",
    "@dudousxd/nestjs-agent-testing": "workspace:*",
    "@nestjs/common": "12.0.4",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-express": "12.0.4",
    "@nestjs/testing": "12.0.4",
    "@types/supertest": "6.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "supertest": "7.0.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "2.1.9",
    "@dudousxd/nestjs-durable": "0.45.1",
    "@dudousxd/nestjs-durable-core": "0.72.1",
    "@dudousxd/nestjs-durable-transport-event-emitter": "0.5.1",
    "@nestjs/event-emitter": "12.0.1",
    "zod": "3.25.76"
  },
  "peerDependenciesMeta": {
    "@dudousxd/nestjs-durable": {
      "optional": true
    },
    "@dudousxd/nestjs-durable-core": {
      "optional": true
    }
  }
}
