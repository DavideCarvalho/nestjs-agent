{
  "name": "@dudousxd/nestjs-agent-telescope",
  "version": "0.7.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-agent.git",
    "directory": "packages/telescope"
  },
  "description": "nestjs-agent telescope extension — an 'Agent' dashboard tab",
  "license": "MIT",
  "author": "Davide Carvalho",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dudousxd/nestjs-agent-core": "workspace:*",
    "@dudousxd/nestjs-diagnostics": "0.7.0"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-telescope": ">=1.18.0"
  },
  "devDependencies": {
    "@dudousxd/nestjs-telescope": "1.18.0",
    "tsup": "8.3.5",
    "typescript": "5.9.3"
  }
}
