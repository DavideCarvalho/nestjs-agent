{
  "name": "@dudousxd/nestjs-agent-dashboard",
  "version": "0.25.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-agent.git",
    "directory": "packages/dashboard"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/agent",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-agent/issues"
  },
  "keywords": [
    "nestjs",
    "agent",
    "dashboard"
  ],
  "description": "Embedded AI-gateway governance console (spend, models, actors/budgets, runs/tools, live feed) for nestjs-agent — bundled React SPA served by NestJS",
  "license": "MIT",
  "author": "Davide Carvalho",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/aviary-kit/fonts.ts"
  ],
  "main": "./dist/server/index.cjs",
  "module": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      }
    },
    "./client": {
      "types": "./dist/client/agent-client.d.ts",
      "import": "./dist/client/agent-client.js",
      "default": "./dist/client/agent-client.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "node ../../scripts/check-package-exports.mjs",
    "build": "vite build && tsup && tsc -p tsconfig.client.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.server.spec.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "typecheck:specs": "tsc -p tsconfig.server.spec.json --noEmit && tsc -p tsconfig.app.json --noEmit"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-agent-core": ">=0.1.0 <1.0.0",
    "@nestjs/authorization": ">=0.1.3 <0.2.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/authorization": {
      "optional": true
    }
  },
  "dependencies": {
    "@dudousxd/nestjs-diagnostics": ">=0.7.0 <1.0.0",
    "react-is": "19.3.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@dudousxd/nestjs-agent-core": "workspace:*",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "@nestjs/authorization": "0.1.3",
    "@nestjs/common": "12.0.4",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-express": "12.0.4",
    "@nestjs/testing": "12.0.4",
    "@swc/core": "1.16.22",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.104.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "4.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "happy-dom": "20.11.1",
    "jsdom": "26.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "supertest": "7.0.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tsup": "8.5.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=24"
  }
}
