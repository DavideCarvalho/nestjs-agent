{
  "name": "@dudousxd/nestjs-agent-mcp",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-agent.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/agent",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-agent/issues"
  },
  "keywords": [
    "nestjs",
    "agent",
    "mcp"
  ],
  "description": "nestjs-agent MCP client — import an external Model Context Protocol server's tools as governed nestjs-agent tools",
  "license": "MIT",
  "author": "Davide Carvalho",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:specs": "tsc -p tsconfig.spec.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@standard-schema/spec": "1.1.0"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-agent-core": ">=0.10.0 <1.0.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0"
  },
  "devDependencies": {
    "@dudousxd/nestjs-agent": "workspace:*",
    "@dudousxd/nestjs-agent-core": "workspace:*",
    "@dudousxd/nestjs-agent-testing": "workspace:*",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/testing": "12.0.3",
    "reflect-metadata": "0.2.2",
    "tsup": "8.3.5",
    "typescript": "5.9.3",
    "vitest": "2.1.9",
    "zod": "3.25.76"
  }
}
