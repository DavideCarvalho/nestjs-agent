{
  "name": "@dudousxd/nestjs-agent-react",
  "version": "0.35.6",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-agent.git",
    "directory": "packages/react"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/agent",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-agent/issues"
  },
  "keywords": [
    "nestjs",
    "agent",
    "react"
  ],
  "description": "nestjs-agent React adapter — useAgentChat hook, AgentChatTransport (AI SDK v7), REST client, and styling-agnostic chat UI",
  "license": "MIT",
  "author": "Davide Carvalho",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/markdown.js",
    "./dist/markdown.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./markdown": {
      "import": {
        "types": "./dist/markdown.d.ts",
        "default": "./dist/markdown.js"
      },
      "require": {
        "types": "./dist/markdown.d.cts",
        "default": "./dist/markdown.cjs"
      }
    },
    "./genui": {
      "import": {
        "types": "./dist/genui.d.ts",
        "default": "./dist/genui.js"
      },
      "require": {
        "types": "./dist/genui.d.cts",
        "default": "./dist/genui.cjs"
      }
    },
    "./genui/json-render": {
      "import": {
        "types": "./dist/genui-json-render.d.ts",
        "default": "./dist/genui-json-render.js"
      },
      "require": {
        "types": "./dist/genui-json-render.d.cts",
        "default": "./dist/genui-json-render.cjs"
      }
    },
    "./media": {
      "import": {
        "types": "./dist/media.d.ts",
        "default": "./dist/media.js"
      },
      "require": {
        "types": "./dist/media.d.cts",
        "default": "./dist/media.cjs"
      }
    },
    "./genui/server": {
      "import": {
        "types": "./dist/genui-server.d.ts",
        "default": "./dist/genui-server.js"
      },
      "require": {
        "types": "./dist/genui-server.d.cts",
        "default": "./dist/genui-server.cjs"
      }
    },
    "./genui/server/playwright": {
      "import": {
        "types": "./dist/genui-server-playwright.d.ts",
        "default": "./dist/genui-server-playwright.js"
      },
      "require": {
        "types": "./dist/genui-server-playwright.d.cts",
        "default": "./dist/genui-server-playwright.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test:dist": "node scripts/verify-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:specs": "tsc -p tsconfig.spec.json"
  },
  "dependencies": {
    "@dudousxd/nestjs-agent-core": "workspace:*"
  },
  "peerDependencies": {
    "@ai-sdk/react": "^4.0.0",
    "@dudousxd/nestjs-media-client": ">=0.3.0",
    "@json-render/react": ">=0.21.0 <1.0.0",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "ai": "^7.0.0",
    "katex": "^0.16.45",
    "prism-react-renderer": "^2.4.1",
    "react": ">=18",
    "react-dom": ">=18",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "streamdown": "^2.5.0",
    "unist-util-visit": "^5.1.0",
    "playwright-core": ">=1.48 <2"
  },
  "peerDependenciesMeta": {
