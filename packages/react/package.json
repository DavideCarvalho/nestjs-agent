{
  "name": "@dudousxd/nestjs-agent-react",
  "version": "0.1.0",
  "description": "nestjs-agent React adapter — useAgentChat hook, AgentChatTransport (AI SDK v6), REST client, and styling-agnostic chat UI",
  "license": "MIT",
  "author": "Davide Carvalho",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dudousxd/nestjs-agent-core": "workspace:*"
  },
  "peerDependencies": {
    "@ai-sdk/react": "^3.0.0",
    "ai": "^6.0.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@ai-sdk/react": "3.0.170",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.5",
    "ai": "6.0.168",
    "jsdom": "26.1.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tsup": "8.3.5",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
