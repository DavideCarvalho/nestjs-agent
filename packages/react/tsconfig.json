{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // Off on purpose. The base config turns decorator metadata on for the NestJS packages, and
    // tsup answers `emitDecoratorMetadata` by compiling through swc — whose JSX transform is the
    // classic one (`React.createElement`), whatever `jsx` says above. Nothing here has a decorator.
    "experimentalDecorators": false,
    "emitDecoratorMetadata": false,
    "outDir": "dist",
    "rootDir": "src",
    // The React Native entry compiles against the slice of `react-native` / `react-native-webview`
    // it uses (`types/`): the real `react-native` types declare globals of their own that clash
    // with the DOM lib this package builds against. The emitted declarations import the real
    // modules, which an app resolves to the real packages.
    "paths": {
      "react-native": ["./types/react-native.d.ts"],
      "react-native-webview": ["./types/react-native-webview.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.spec.tsx", "dist", "node_modules"]
}
