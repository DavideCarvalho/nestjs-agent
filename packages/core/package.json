{
  "name": "@dudousxd/nestjs-agent-core",
  "version": "0.58.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-agent.git",
    "directory": "packages/core"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/agent",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-agent/issues"
  },
  "keywords": [
    "nestjs",
    "agent",
    "core",
    "guardrails",
    "generative-ui",
    "a2ui"
  ],
  "description": "nestjs-agent core — agent loop, tool registry, governance SPIs",
  "license": "MIT",
  "author": "Davide Carvalho",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./guardrails": {
      "import": {
        "types": "./dist/guardrails/index.d.ts",
        "default": "./dist/guardrails/index.js"
      },
      "require": {
        "types": "./dist/guardrails/index.d.cts",
        "default": "./dist/guardrails/index.cjs"
      }
    },
    "./genui": {
      "import": {
        "types": "./dist/genui/index.d.ts",
        "default": "./dist/genui/index.js"
      },
      "require": {
        "types": "./dist/genui/index.d.cts",
        "default": "./dist/genui/index.cjs"
      }
    },
    "./genui/builtins": {
      "import": {
        "types": "./dist/genui/builtins.d.ts",
        "default": "./dist/genui/builtins.js"
      },
      "require": {
        "types": "./dist/genui/builtins.d.cts",
        "default": "./dist/genui/builtins.cjs"
      }
    },
    "./genui/chart-image": {
      "import": {
        "types": "./dist/genui/chart-image.d.ts",
        "default": "./dist/genui/chart-image.js"
      },
      "require": {
        "types": "./dist/genui/chart-image.d.cts",
        "default": "./dist/genui/chart-image.cjs"
      }
    },
    "./genui/kit": {
      "import": {
        "types": "./dist/genui/kit/index.d.ts",
        "default": "./dist/genui/kit/index.js"
      },
      "require": {
        "types": "./dist/genui/kit/index.d.cts",
        "default": "./dist/genui/kit/index.cjs"
      }
    },
    "./ag-ui": {
      "import": {
        "types": "./dist/ag-ui/index.d.ts",
        "default": "./dist/ag-ui/index.js"
      },
      "require": {
        "types": "./dist/ag-ui/index.d.cts",
        "default": "./dist/ag-ui/index.cjs"
      }
    },
    "./a2ui": {
      "import": {
        "types": "./dist/a2ui/index.d.ts",
        "default": "./dist/a2ui/index.js"
      },
      "require": {
        "types": "./dist/a2ui/index.d.cts",
        "default": "./dist/a2ui/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build-frame-runtime.mjs && tsup",
    "gen:frame": "node scripts/build-frame-runtime.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:specs": "tsc -p tsconfig.spec.json"
  },
  "dependencies": {
    "@dudousxd/nestjs-diagnostics": "0.7.2",
    "@standard-schema/spec": "1.1.0",
    "@tailwindcss/browser": "4.3.3",
    "acorn": "8.17.0",
    "acorn-jsx": "5.3.2"
  },
  "peerDependencies": {
    "@resvg/resvg-js": "^2.6.0",
    "typescript": ">=5",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "@resvg/resvg-js": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ag-ui/client": "1.0.1",
    "@ag-ui/core": "1.0.1",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource-variable/geist": "5.3.0",
    "@mui/material": "7.3.11",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "ajv": "8.20.0",
    "bootstrap": "5.3.8",
    "esbuild": "0.28.1",
    "playwright-core": "1.64.0",
    "prop-types": "15.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rxjs": "7.8.2",
    "sass": "1.105.1",
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "zod": "3.25.76"
  }
}
