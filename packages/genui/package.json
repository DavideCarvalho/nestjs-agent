{
  "name": "@dudousxd/nestjs-agent-genui",
  "version": "0.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-agent.git",
    "directory": "packages/genui"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/agent",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-agent/issues"
  },
  "keywords": [
    "nestjs",
    "agent",
    "generative-ui",
    "genui"
  ],
  "description": "nestjs-agent generative UI — an isomorphic component catalog (Standard Schema or JSON Schema props), validation, model-facing catalog text, plain-text fallbacks and tool factories that push `ui` frames. Headless: no visual components.",
  "license": "MIT",
  "author": "Davide Carvalho",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./builtins": {
      "import": {
        "types": "./dist/builtins.d.ts",
        "default": "./dist/builtins.js"
      },
      "require": {
        "types": "./dist/builtins.d.cts",
        "default": "./dist/builtins.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:specs": "tsc -p tsconfig.spec.json"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-agent-core": ">=0.22.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@dudousxd/nestjs-agent-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dudousxd/nestjs-agent-core": "workspace:*",
    "@dudousxd/nestjs-agent-testing": "workspace:*",
    "ajv": "8.20.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "2.1.9",
    "zod": "3.25.76"
  }
}
