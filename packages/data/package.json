{
  "name": "@dudousxd/nestjs-agent-data",
  "version": "0.3.19",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-agent.git",
    "directory": "packages/data"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/agent",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-agent/issues"
  },
  "keywords": [
    "nestjs",
    "agent",
    "data"
  ],
  "description": "nestjs-agent data — governed read-only SQL satellite (single-SELECT validation, fail-closed table access, tenant scoping)",
  "license": "MIT",
  "author": "Davide Carvalho",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:specs": "tsc -p tsconfig.spec.json"
  },
  "dependencies": {
    "@dudousxd/nestjs-agent-core": "workspace:*",
    "node-sql-parser": "5.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@dudousxd/nestjs-agent-core": "workspace:*",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
