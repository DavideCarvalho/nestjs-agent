{
  "name": "@dudousxd/nestjs-agent-transport-redis",
  "version": "0.1.0",
  "description": "nestjs-agent Redis token-stream transport — a multi-replica TokenStreamSink over Redis pub/sub + list replay",
  "license": "MIT",
  "author": "Davide Carvalho",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-agent-core": "workspace:*"
  },
  "devDependencies": {
    "@dudousxd/nestjs-agent-core": "workspace:*",
    "tsup": "8.3.5",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
