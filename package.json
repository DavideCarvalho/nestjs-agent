{
  "name": "nestjs-agent-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Governed, durable-backed AI agent (chat + tool-calling) for NestJS",
  "license": "MIT",
  "author": "Davide Carvalho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-agent.git"
  },
  "packageManager": "pnpm@11.28.11",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check:exports": "node scripts/check-package-exports.mjs --all",
    "check:package": "node scripts/check-package.mjs",
    "build": "turbo run build",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "typecheck:specs": "turbo run typecheck:specs",
    "lint": "biome check .",
    "check:dist": "node scripts/check-dist-react.mjs && node scripts/check-dist-nestjs-di.mjs && pnpm --filter @dudousxd/nestjs-agent-react test:dist",
    "lint:fix": "biome check --write .",
    "changeset": "changeset",
    "version-packages": "changeset version && biome check --write .",
    "release": "pnpm --filter './packages/*' build && pnpm check:exports && pnpm check:package && pnpm check:dist && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "1.9.4",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@swc/core": "1.16.22",
    "@testcontainers/mysql": "12.2.0",
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "24.19.2",
    "publint": "0.3.25",
    "reflect-metadata": "0.2.2",
    "testcontainers": "12.2.0",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "unplugin-swc": "1.6.0",
    "vitest": "2.1.9"
  }
}
