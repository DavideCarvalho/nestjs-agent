{
  "name": "nestjs-agent-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Governed, durable-backed AI agent (chat + tool-calling) for NestJS",
  "license": "MIT",
  "author": "Davide Carvalho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-agent.git"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "typecheck:specs": "turbo run typecheck:specs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "changeset": "changeset",
    "version-packages": "changeset version && biome check --write .",
    "release": "pnpm --filter './packages/*' build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@swc/core": "1.16.2",
    "@types/node": "22.20.4",
    "reflect-metadata": "0.2.2",
    "turbo": "2.11.3",
    "typescript": "5.9.3",
    "unplugin-swc": "1.6.0",
    "vitest": "2.1.9"
  }
}
